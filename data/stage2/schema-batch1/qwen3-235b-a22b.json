{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MetalOrganicCageSynthesisSchema",
    "type": "object",
    "description": "JSON schema representing the Metal-Organic Cage (MOC) synthesis process",
    "required": [
        "moc_type",
        "components",
        "process_parameters",
        "characterization",
        "functional_properties"
    ],
    "properties": {
        "moc_type": {
            "type": "object",
            "description": "Chemical formula and naming convention for the MOC",
            "required": [
                "formula",
                "name"
            ],
            "properties": {
                "formula": {
                    "type": "string",
                    "description": "Chemical formula in [MxLy]n[counter_ion]-n format. Stoichiometry defines geometry."
                },
                "name": {
                    "type": "string",
                    "description": "Common identifier (e.g., 'MOC 1' or 'Cage 1')"
                },
                "metal_count": {
                    "type": "integer",
                    "description": "Number of metal ions in the MOC structure"
                },
                "ligand_count": {
                    "type": "integer",
                    "description": "Number of organic ligands in the MOC structure"
                },
                "cavity_volume": {
                    "type": "number",
                    "description": "Volume of the MOC cavity in \u00c5\u00b3"
                },
                "cavity_hydrophobicity": {
                    "type": "boolean",
                    "description": "Indicates if the cavity is hydrophobic"
                }
            }
        },
        "components": {
            "type": "object",
            "description": "Chemical components used in synthesis",
            "required": [
                "metal_sources",
                "ligands",
                "counter_ions"
            ],
            "properties": {
                "metal_sources": {
                    "type": "object",
                    "description": "Metal ion donor compound",
                    "required": [
                        "name",
                        "chemical_formula",
                        "purity",
                        "source"
                    ],
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "chemical_formula": {
                            "type": "string"
                        },
                        "purity": {
                            "type": "number",
                            "description": "Percentage purity (e.g., 99.9)"
                        },
                        "source": {
                            "type": "string",
                            "description": "Supplier or synthesis origin"
                        }
                    }
                },
                "ligands": {
                    "type": "object",
                    "description": "Organic linker molecule",
                    "required": [
                        "name",
                        "chemical_formula",
                        "purity",
                        "source",
                        "synthesis_needed"
                    ],
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "chemical_formula": {
                            "type": "string"
                        },
                        "purity": {
                            "type": "number"
                        },
                        "source": {
                            "type": "string"
                        },
                        "synthesis_needed": {
                            "type": "boolean"
                        },
                        "synthesis_steps": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "action": {
                                        "type": "string"
                                    },
                                    "parameters": {
                                        "$ref": "#/definitions/reaction_conditions"
                                    }
                                },
                                "required": [
                                    "action",
                                    "parameters"
                                ]
                            },
                            "description": "Reaction steps if ligand requires pre-synthesis"
                        }
                    }
                },
                "counter_ions": {
                    "type": "object",
                    "description": "Charge-balancing ion source",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "chemical_formula": {
                            "type": "string"
                        },
                        "purity": {
                            "type": "number"
                        },
                        "source": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "process_parameters": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "step_number": {
                        "type": "integer"
                    },
                    "action": {
                        "type": "string"
                    },
                    "parameters": {
                        "$ref": "#/definitions/reaction_conditions"
                    }
                },
                "required": [
                    "step_number",
                    "action",
                    "parameters"
                ]
            },
            "description": "Sequential synthesis steps"
        },
        "characterization": {
            "type": "array",
            "items": {
                "type": "object",
                "description": "Analytical methods used",
                "required": [
                    "technique",
                    "description",
                    "data"
                ],
                "properties": {
                    "technique": {
                        "type": "string",
                        "description": "Method name (e.g., NMR)"
                    },
                    "description": {
                        "type": "string",
                        "description": "Experimental parameters"
                    },
                    "data": {
                        "type": "object",
                        "description": "Results or file references"
                    }
                }
            }
        },
        "functional_properties": {
            "type": "object",
            "properties": {
                "host_guest": {
                    "type": "object",
                    "properties": {
                        "present": {
                            "type": "boolean"
                        },
                        "guests": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "molecule_name": {
                                        "type": "string"
                                    },
                                    "chemical_formula": {
                                        "type": "string"
                                    },
                                    "interaction_type": {
                                        "type": "string",
                                        "description": "Binding mechanism (e.g., solvent-dependent interactions)"
                                    },
                                    "binding_constant": {
                                        "type": "number",
                                        "description": "Association constant in M\u20132"
                                    },
                                    "stoichiometry": {
                                        "type": "number",
                                        "description": "Molar ratio of host:guest"
                                    }
                                }
                            }
                        }
                    }
                },
                "other_characterization": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "description": "Additional measured characteristics",
                        "properties": {
                            "property_name": {
                                "type": "string"
                            },
                            "value": {
                                "type": "number"
                            },
                            "unit": {
                                "type": "string"
                            }
                        }
                    }
                },
                "recyclability": {
                    "type": "object",
                    "properties": {
                        "cycles": {
                            "type": "integer",
                            "description": "Number of recycling cycles performed"
                        },
                        "recovery_efficiency": {
                            "type": "number",
                            "description": "Percentage recovery after recycling"
                        }
                    }
                },
                "pfos_removal_capacity": {
                    "type": "number",
                    "description": "Maximum PFOS removal capacity in equivalents per MOC"
                }
            }
        },
        "stereochemistry": {
            "type": "object",
            "description": "Geometric and spatial arrangement details",
            "properties": {
                "geometry": {
                    "type": "string",
                    "description": "Cage topology (e.g., tetrahedral, cubic)"
                },
                "chirality": {
                    "type": "string",
                    "description": "Chiral configuration if applicable"
                },
                "symmetry": {
                    "type": "string",
                    "description": "Point group symmetry (e.g., Th, O)"
                }
            }
        },
        "yield": {
            "type": "number",
            "description": "Percentage yield of the MOC synthesis"
        },
        "scale": {
            "type": "number",
            "description": "Reaction scale in mmol"
        },
        "crystallisation_method": {
            "type": "string",
            "description": "Method used for crystallization (e.g., slow evaporation, diffusion)"
        },
        "purification_method": {
            "type": "string",
            "description": "Purification techniques applied"
        }
    },
    "definitions": {
        "reaction_conditions": {
            "type": "object",
            "properties": {
                "temperature": {
                    "type": "number",
                    "description": "Reaction temperature in Celsius"
                },
                "time": {
                    "type": "number",
                    "description": "Duration in hours"
                },
                "solvent": {
                    "type": "string",
                    "description": "Solvent used (e.g., acetonitrile, cyclohexane)"
                },
                "pressure": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Pascals unit"
                        },
                        "vacuum": {
                            "type": "boolean"
                        }
                    }
                }
            },
            "required": [
                "temperature",
                "time",
                "solvent",
                "pressure"
            ]
        }
    }
}