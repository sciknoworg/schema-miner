{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/moc-synthesis.json",
    "title": "Metal-Organic Cages (MOC) Synthesis Process",
    "description": "A comprehensive JSON schema representing the synthesis, characterization, and properties of Metal-Organic Cages (MOCs), including reactants, process parameters, characterization methods, host-guest behavior, recycling, and material properties. Designed for reproducibility, modularity, and alignment with chemical best practices.",
    "type": "object",
    "required": [
        "moc_type",
        "synthesis",
        "characterisation",
        "host_guest_properties",
        "material_properties"
    ],
    "properties": {
        "moc_type": {
            "type": "object",
            "description": "The chemical formula, designation, and structural composition of the Metal-Organic Cage (MOC), including metal ions, ligands, stoichiometry, and counterions.",
            "properties": {
                "formula": {
                    "type": "string",
                    "description": "The chemical formula of the MOC, e.g., [Zn6L4]4+ or [Pd4L6]4+.",
                    "example": "[Pd4L6]4+"
                },
                "designation": {
                    "type": "string",
                    "description": "Common name or identifier used in literature (e.g., 'Cage 1', 'MOC-1').",
                    "example": "MOC-PFOS-1"
                },
                "composition": {
                    "type": "object",
                    "description": "Unified representation of the stoichiometric composition of the MOC, including metal and ligand counts and net charge.",
                    "properties": {
                        "metal": {
                            "type": "number",
                            "description": "Number of metal ions (M) in the cage unit.",
                            "minimum": 1,
                            "example": 6
                        },
                        "ligand": {
                            "type": "number",
                            "description": "Number of ligand molecules (L) in the cage unit.",
                            "minimum": 1,
                            "example": 4
                        },
                        "charge": {
                            "type": "number",
                            "description": "Net charge of the cage complex (e.g., +4, -2).",
                            "example": 4
                        }
                    },
                    "required": [
                        "metal",
                        "ligand",
                        "charge"
                    ]
                },
                "counter_ion": {
                    "type": "string",
                    "description": "Counterion used to balance the charge of the cage complex (e.g., Cl\u207b, BF\u2084\u207b, NO\u2083\u207b).",
                    "example": "NO3-"
                }
            },
            "required": [
                "formula",
                "designation",
                "composition"
            ]
        },
        "synthesis": {
            "type": "object",
            "description": "Comprehensive description of the MOC synthesis process, including reactants, reaction conditions, step-by-step procedure, and workup.",
            "properties": {
                "reactants": {
                    "type": "object",
                    "description": "All reactants used in the synthesis, including metal sources, ligands, and counterion sources.",
                    "properties": {
                        "metal_source": {
                            "type": "object",
                            "description": "The source compound of the metal ion used in the synthesis.",
                            "properties": {
                                "compound": {
                                    "type": "string",
                                    "description": "Chemical name or formula of the metal salt (e.g., Pd(NO\u2083)\u2082\u00b72H\u2082O).",
                                    "example": "Pd(NO3)2\u00b72H2O"
                                },
                                "purity": {
                                    "type": "string",
                                    "description": "Purity of the metal salt (e.g., 98%, ACS grade).",
                                    "example": "99%"
                                },
                                "supplier": {
                                    "type": "string",
                                    "description": "Supplier or manufacturer of the metal salt.",
                                    "example": "Sigma-Aldrich"
                                }
                            },
                            "required": [
                                "compound"
                            ]
                        },
                        "ligand": {
                            "type": "object",
                            "description": "The organic ligand (L) used in the self-assembly process.",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "Common or IUPAC name of the ligand (e.g., 1,3,5-tris(4-pyridyl)benzene).",
                                    "example": "TPB"
                                },
                                "formula": {
                                    "type": "string",
                                    "description": "Chemical formula of the ligand.",
                                    "example": "C15H12N6"
                                },
                                "purity": {
                                    "type": "string",
                                    "description": "Purity of the ligand (e.g., 95%, HPLC grade).",
                                    "example": "95%"
                                },
                                "supplier": {
                                    "type": "string",
                                    "description": "Supplier or manufacturer of the ligand.",
                                    "example": "TCI Chemicals"
                                },
                                "synthesis_required": {
                                    "type": "boolean",
                                    "description": "Indicates whether the ligand must be pre-synthesized (true) or is commercially available (false).",
                                    "default": false
                                }
                            },
                            "required": [
                                "name",
                                "formula"
                            ]
                        },
                        "counter_ion_source": {
                            "type": "array",
                            "description": "List of compounds used to supply counterions (e.g., NaNO\u2083, HNO\u2083).",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "compound": {
                                        "type": "string",
                                        "description": "Chemical name or formula of the counterion source.",
                                        "example": "NaNO3"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "description": "Amount of counterion source added (in moles or grams).",
                                        "example": 0.004
                                    },
                                    "unit": {
                                        "type": "string",
                                        "enum": [
                                            "mol",
                                            "g",
                                            "mmol"
                                        ],
                                        "description": "Unit of amount (mol, g, mmol)."
                                    }
                                },
                                "required": [
                                    "compound",
                                    "amount",
                                    "unit"
                                ]
                            }
                        }
                    },
                    "required": [
                        "metal_source",
                        "ligand"
                    ]
                },
                "reaction_conditions": {
                    "type": "object",
                    "description": "General conditions under which the synthesis is performed.",
                    "properties": {
                        "temperature": {
                            "type": "number",
                            "description": "Reaction temperature in degrees Celsius.",
                            "unit": "\u00b0C",
                            "minimum": -273.15,
                            "example": 60
                        },
                        "time": {
                            "type": "number",
                            "description": "Total reaction duration in hours.",
                            "unit": "h",
                            "minimum": 0,
                            "example": 24
                        },
                        "solvent": {
                            "type": "string",
                            "description": "Primary solvent used in the synthesis.",
                            "example": "DMF"
                        },
                        "atmosphere": {
                            "type": "string",
                            "enum": [
                                "air",
                                "inert",
                                "vacuum",
                                "N2",
                                "Ar"
                            ],
                            "description": "Atmosphere under which the reaction is performed.",
                            "example": "N2"
                        }
                    },
                    "required": [
                        "temperature",
                        "time",
                        "solvent"
                    ]
                },
                "procedure": {
                    "type": "array",
                    "description": "Sequential steps of the MOC synthesis process, including mixing, heating, solvent removal, etc.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "step": {
                                "type": "integer",
                                "description": "Sequential step number in the synthesis process.",
                                "minimum": 1,
                                "example": 1
                            },
                            "description": {
                                "type": "string",
                                "description": "Textual description of the step (e.g., 'Mix Pd(NO\u2083)\u2082 and ligand in DMF at 60\u00b0C').",
                                "example": "Mix Pd(NO3)2\u00b72H2O and ligand in DMF at 60\u00b0C for 24 h"
                            },
                            "temperature": {
                                "type": "number",
                                "description": "Temperature during this step in degrees Celsius.",
                                "unit": "\u00b0C",
                                "minimum": -273.15,
                                "example": 60
                            },
                            "time": {
                                "type": "number",
                                "description": "Duration of this step in hours.",
                                "unit": "h",
                                "minimum": 0,
                                "example": 24
                            },
                            "solvent": {
                                "type": "string",
                                "description": "Solvent used in this step.",
                                "example": "DMF"
                            },
                            "pressure": {
                                "type": "number",
                                "description": "Pressure during the step (if applicable), in Pascals (Pa).",
                                "unit": "Pa",
                                "minimum": 0,
                                "example": 101325
                            },
                            "atmosphere": {
                                "type": "string",
                                "enum": [
                                    "air",
                                    "inert",
                                    "vacuum",
                                    "N2",
                                    "Ar"
                                ],
                                "description": "Atmosphere under which the step was performed.",
                                "example": "N2"
                            },
                            "additional_notes": {
                                "type": "string",
                                "description": "Any additional details about the step (e.g., 'stirred magnetically', 'filtered through syringe filter').",
                                "example": "Stirred at 600 rpm"
                            }
                        },
                        "required": [
                            "step",
                            "description"
                        ]
                    }
                },
                "workup": {
                    "type": "object",
                    "description": "Post-reaction procedures used to isolate and purify the MOC.",
                    "properties": {
                        "solvent_removal": {
                            "type": "string",
                            "description": "Method used to remove solvent (e.g., rotary evaporation, vacuum drying).",
                            "example": "Rotary evaporation under vacuum"
                        },
                        "purification_method": {
                            "type": "string",
                            "description": "Method used to purify the final product (e.g., column chromatography, recrystallization, dialysis).",
                            "example": "Column chromatography (SiO2, CH2Cl2/MeOH)"
                        },
                        "yield": {
                            "type": "number",
                            "description": "Yield of the MOC synthesis in percentage.",
                            "unit": "%",
                            "minimum": 0,
                            "maximum": 100,
                            "example": 78
                        },
                        "concentration": {
                            "type": "number",
                            "description": "Concentration of the MOC in the final solution (in mg/mL or M).",
                            "unit": "mg/mL",
                            "example": 1.5
                        }
                    },
                    "required": [
                        "solvent_removal",
                        "purification_method",
                        "yield"
                    ]
                }
            },
            "required": [
                "reactants",
                "reaction_conditions",
                "procedure",
                "workup"
            ]
        },
        "characterisation": {
            "type": "array",
            "description": "Methods used to confirm the identity, structure, and purity of the synthesized MOC, with standardized output structure.",
            "items": {
                "type": "object",
                "properties": {
                    "technique": {
                        "type": "string",
                        "enum": [
                            "NMR",
                            "Mass Spectrometry",
                            "PXRD",
                            "IR",
                            "DOSY",
                            "UV-Vis",
                            "TGA",
                            "EA",
                            "X-ray Crystallography",
                            "ESI-MS",
                            "MALDI-TOF",
                            "FTIR",
                            "Cryo-EM",
                            "SAXS"
                        ],
                        "description": "Analytical technique used for characterization.",
                        "example": "ESI-MS"
                    },
                    "instrument": {
                        "type": "string",
                        "description": "Name or model of the instrument used.",
                        "example": "Agilent 6140 LC-MS"
                    },
                    "conditions": {
                        "type": "object",
                        "description": "Specific conditions under which the measurement was performed.",
                        "properties": {
                            "temperature": {
                                "type": "number",
                                "description": "Temperature during measurement (\u00b0C).",
                                "unit": "\u00b0C",
                                "example": 25
                            },
                            "solvent": {
                                "type": "string",
                                "description": "Solvent used in the measurement.",
                                "example": "CDCl3"
                            },
                            "concentration": {
                                "type": "number",
                                "description": "Concentration of the sample (in mg/mL or M).",
                                "unit": "mg/mL",
                                "example": 1.5
                            }
                        },
                        "required": [
                            "temperature",
                            "solvent"
                        ]
                    },
                    "results": {
                        "type": "string",
                        "description": "Key result or observation from the technique (e.g., 'Peak at m/z = 1245.3 [M+H]+').",
                        "example": "Peak at m/z = 1245.3 [M+H]+"
                    },
                    "resolution": {
                        "type": "string",
                        "description": "Resolution or quality of the data (e.g., 'high resolution', 'low resolution').",
                        "example": "high resolution"
                    },
                    "interpretation": {
                        "type": "string",
                        "description": "Interpretation of the result in the context of MOC identity or structure.",
                        "example": "Confirmed the formation of the [Pd4L6]4+ cage via molecular ion peak"
                    }
                },
                "required": [
                    "technique",
                    "instrument",
                    "conditions",
                    "results"
                ]
            }
        },
        "host_guest_properties": {
            "type": "object",
            "description": "Properties related to the ability of the MOC to bind small molecules (guests), including binding stoichiometry, affinity, and applications.",
            "properties": {
                "guests_bound": {
                    "type": "array",
                    "description": "List of guest molecules that the MOC can encapsulate.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "molecule": {
                                "type": "string",
                                "description": "Name or formula of the guest molecule (e.g., CO\u2082, H\u2082, CH\u2084, PFOS).",
                                "example": "PFOS"
                            },
                            "binding_mode": {
                                "type": "string",
                                "description": "How the guest binds (e.g., 'encapsulated in cavity', 'surface adsorption', 'ion exchange').",
                                "example": "encapsulated in cavity via fluorous interactions"
                            },
                            "binding_affinity": {
                                "type": "number",
                                "description": "Binding constant (K) or association constant (Ka) in M\u207b\u00b9 or M\u207b\u00b2 (depending on stoichiometry).",
                                "unit": "M\u207b\u00b9",
                                "example": 19300000.0
                            },
                            "stoichiometry": {
                                "type": "string",
                                "description": "Molar ratio of guest to cage (e.g., 1:1, 2:1, 4:1).",
                                "example": "2:1"
                            },
                            "method": {
                                "type": "string",
                                "description": "Method used to determine guest binding (e.g., NMR titration, ITC, DOSY, ion-exchange chromatography).",
                                "example": "NMR titration and DOSY"
                            }
                        },
                        "required": [
                            "molecule",
                            "binding_mode",
                            "stoichiometry",
                            "method"
                        ]
                    }
                },
                "applications": {
                    "type": "array",
                    "description": "Potential applications of the MOC based on host-guest behavior.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "Gas storage",
                            "Gas separation",
                            "Catalysis",
                            "Drug delivery",
                            "Sensing",
                            "Molecular recognition",
                            "Environmental remediation"
                        ],
                        "example": "Environmental remediation"
                    }
                },
                "recycling": {
                    "type": "object",
                    "description": "Details about the recovery and reuse of the MOC after guest binding.",
                    "properties": {
                        "procedure": {
                            "type": "string",
                            "description": "Description of the recycling process (e.g., dissolution in CH3CN, addition of tetrabutylammonium nitrate).",
                            "example": "Dissolve the precipitate in CH3CN, add tetrabutylammonium nitrate to recover the MOC"
                        },
                        "cycles": {
                            "type": "integer",
                            "description": "Number of successful recycling cycles demonstrated.",
                            "minimum": 1,
                            "example": 3
                        },
                        "recovery_yield": {
                            "type": "number",
                            "description": "Percentage of MOC recovered after recycling cycles.",
                            "unit": "%",
                            "minimum": 0,
                            "maximum": 100,
                            "example": 94.5
                        },
                        "purity_check": {
                            "type": "string",
                            "description": "Method used to confirm the purity of the recovered MOC (e.g., 1H NMR, 19F NMR).",
                            "example": "1H NMR in D2O matched authentic sample; 19F NMR showed no PFOS signal"
                        }
                    },
                    "required": [
                        "procedure",
                        "cycles",
                        "recovery_yield",
                        "purity_check"
                    ]
                }
            },
            "required": [
                "guests_bound",
                "applications",
                "recycling"
            ]
        },
        "material_properties": {
            "type": "object",
            "description": "Other measurable physical and chemical properties of the MOC, including stability, porosity, and electronic behavior.",
            "properties": {
                "stability": {
                    "type": "object",
                    "description": "Stability of the MOC under various conditions.",
                    "properties": {
                        "thermal_stability": {
                            "type": "number",
                            "description": "Temperature at which the MOC begins to decompose (\u00b0C).",
                            "unit": "\u00b0C",
                            "example": 320
                        },
                        "chemical_stability": {
                            "type": "string",
                            "description": "Stability in different solvents or pH conditions (e.g., 'stable in DMF, decomposes in water').",
                            "example": "Stable in DMF and CHCl3; decomposes in water"
                        },
                        "long_term_stability": {
                            "type": "string",
                            "description": "Stability over time (e.g., 'stable for >6 months at room temperature').",
                            "example": "Stable for >1 year at 4\u00b0C"
                        }
                    },
                    "required": [
                        "thermal_stability",
                        "chemical_stability",
                        "long_term_stability"
                    ]
                },
                "physical_properties": {
                    "type": "object",
                    "description": "Other measurable physical properties of the MOC.",
                    "properties": {
                        "conductivity": {
                            "type": "number",
                            "description": "Electrical conductivity of the MOC (in S/cm).",
                            "unit": "S/cm",
                            "example": 1.2e-06
                        },
                        "BET_surface_area": {
                            "type": "number",
                            "description": "Brunauer\u2013Emmett\u2013Teller (BET) surface area (in m\u00b2/g).",
                            "unit": "m\u00b2/g",
                            "example": 1200
                        },
                        "porosity": {
                            "type": "number",
                            "description": "Total pore volume (in cm\u00b3/g).",
                            "unit": "cm\u00b3/g",
                            "example": 0.65
                        },
                        "crystallinity": {
                            "type": "string",
                            "enum": [
                                "crystalline",
                                "amorphous",
                                "semi-crystalline"
                            ],
                            "description": "Crystalline nature of the material."
                        },
                        "cavity_volume": {
                            "type": "number",
                            "description": "Volume of the internal cavity (in \u00c5\u00b3).",
                            "unit": "\u00c5\u00b3",
                            "example": 482
                        }
                    },
                    "required": [
                        "BET_surface_area",
                        "porosity",
                        "crystallinity",
                        "cavity_volume"
                    ]
                },
                "stereochemistry": {
                    "type": "string",
                    "description": "Description of the stereochemistry of the cage (e.g., 'chiral cage with P-helicity', 'achiral, symmetric').",
                    "example": "Chiral cage with P-helicity"
                }
            },
            "required": [
                "stability",
                "physical_properties",
                "stereochemistry"
            ]
        },
        "additional_notes": {
            "type": "string",
            "description": "Any other relevant information not covered in other sections, including limitations, future work, or experimental nuances.",
            "example": "The MOC is effective in removing PFOS even in the presence of common anions like NO3-, Cl-, SO4\u00b2-, and PO4\u00b3-. Recycling efficiency is high, but long-term performance under repeated use requires further study."
        }
    },
    "examples": [
        {
            "moc_type": {
                "formula": "[Pd4L6]4+",
                "designation": "MOC-PFOS-1",
                "composition": {
                    "metal": 4,
                    "ligand": 6,
                    "charge": 4
                },
                "counter_ion": "NO3-"
            },
            "synthesis": {
                "reactants": {
                    "metal_source": {
                        "compound": "Pd(NO3)2\u00b72H2O",
                        "purity": "99%",
                        "supplier": "Sigma-Aldrich"
                    },
                    "ligand": {
                        "name": "TPB",
                        "formula": "C15H12N6",
                        "purity": "95%",
                        "supplier": "TCI Chemicals",
                        "synthesis_required": false
                    },
                    "counter_ion_source": [
                        {
                            "compound": "NaNO3",
                            "amount": 0.004,
                            "unit": "mol"
                        }
                    ]
                },
                "reaction_conditions": {
                    "temperature": 60,
                    "time": 24,
                    "solvent": "DMF",
                    "atmosphere": "N2"
                },
                "procedure": [
                    {
                        "step": 1,
                        "description": "Mix Pd(NO3)2\u00b72H2O and ligand in DMF at 60\u00b0C for 24 h",
                        "temperature": 60,
                        "time": 24,
                        "solvent": "DMF",
                        "atmosphere": "N2"
                    },
                    {
                        "step": 2,
                        "description": "Remove solvent in vacuo",
                        "pressure": 100,
                        "atmosphere": "vacuum"
                    }
                ],
                "workup": {
                    "solvent_removal": "Rotary evaporation under vacuum",
                    "purification_method": "Column chromatography (SiO2, CH2Cl2/MeOH)",
                    "yield": 78,
                    "concentration": 1.5
                }
            },
            "characterisation": [
                {
                    "technique": "ESI-MS",
                    "instrument": "Agilent 6140 LC-MS",
                    "conditions": {
                        "temperature": 25,
                        "solvent": "CDCl3",
                        "concentration": 1.5
                    },
                    "results": "Peak at m/z = 1245.3 [M+H]+",
                    "resolution": "high resolution",
                    "interpretation": "Confirmed the formation of the [Pd4L6]4+ cage via molecular ion peak"
                },
                {
                    "technique": "1H NMR",
                    "instrument": "400 MHz NMR",
                    "conditions": {
                        "temperature": 25,
                        "solvent": "D2O",
                        "concentration": 2.0
                    },
                    "results": "Disappearance of resonances a' and b' with formation of a'' and b'' upon addition of 2 equivalents of PFOS",
                    "resolution": "high resolution",
                    "interpretation": "Indicates strong host-guest interaction and stoichiometry of 2:1 (PFOS:MOC)"
                }
            ],
            "host_guest_properties": {
                "guests_bound": [
                    {
                        "molecule": "PFOS",
                        "binding_mode": "encapsulated in cavity via fluorous interactions",
                        "binding_affinity": 19300000.0,
                        "stoichiometry": "2:1",
                        "method": "NMR titration and DOSY"
                    }
                ],
                "applications": [
                    "Environmental remediation"
                ],
                "recycling": {
                    "procedure": "Dissolve the precipitate in CH3CN, add tetrabutylammonium nitrate to recover the MOC",
                    "cycles": 3,
                    "recovery_yield": 94.5,
                    "purity_check": "1H NMR in D2O matched authentic sample; 19F NMR showed no PFOS signal"
                }
            },
            "material_properties": {
                "stability": {
                    "thermal_stability": 320,
                    "chemical_stability": "Stable in DMF and CHCl3; decomposes in water",
                    "long_term_stability": "Stable for >1 year at 4\u00b0C"
                },
                "physical_properties": {
                    "conductivity": 1.2e-06,
                    "BET_surface_area": 1200,
                    "porosity": 0.65,
                    "crystallinity": "crystalline",
                    "cavity_volume": 482
                },
                "stereochemistry": "Chiral cage with P-helicity"
            },
            "additional_notes": "The MOC is effective in removing PFOS even in the presence of common anions like NO3-, Cl-, SO4\u00b2-, and PO4\u00b3-. Recycling efficiency is high, but long-term performance under repeated use requires further study."
        }
    ]
}