{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MetalOrganicCageSynthesisSchema",
    "type": "object",
    "description": "JSON schema representing the Metal-Organic Cage (MOC) synthesis process with host-guest chemistry applications",
    "required": [
        "moc_properties",
        "components",
        "process_parameters",
        "characterization",
        "host_guest_properties",
        "structural_properties"
    ],
    "properties": {
        "moc_properties": {
            "type": "object",
            "description": "Chemical formula and structural characteristics of MOC",
            "required": [
                "formula",
                "name",
                "structural_type"
            ],
            "properties": {
                "formula": {
                    "type": "string",
                    "description": "Chemical formula in [MxLy]n[counter_ion]-n format. Stoichiometry defines geometry."
                },
                "name": {
                    "type": "string",
                    "description": "Common identifier (e.g., 'MOC 1' or 'Cage 1')"
                },
                "structural_type": {
                    "type": "string",
                    "description": "Structural classification (e.g., hexahedral, sandwich)"
                },
                "anion_binding_hierarchy": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Anion selectivity ranking (e.g., NTf\u2082\u207b > OTf\u207b > BF\u2084\u207b)"
                },
                "cavity_volume": {
                    "type": "number",
                    "description": "Volume of the MOC cavity in \u00c5\u00b3 (varies by isomer)"
                },
                "coordination_mode": {
                    "type": "string",
                    "description": "Key coordination patterns (e.g., \u03bc\u2083-\u03ba\u00b2O1:\u03baO2:\u03baN2:\u03baO5)"
                },
                "solvent_effect": {
                    "type": "string",
                    "description": "Solvent-induced structural changes (e.g., acetonitrile \u2192 methanol transition)"
                }
            }
        },
        "components": {
            "type": "object",
            "description": "Chemical components used in synthesis",
            "required": [
                "metal_sources",
                "ligands",
                "counter_ions",
                "template_anions"
            ],
            "properties": {
                "metal_sources": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "chemical_formula": {
                                "type": "string"
                            },
                            "purity": {
                                "type": "number"
                            },
                            "source": {
                                "type": "string"
                            }
                        }
                    }
                },
                "ligands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "chemical_formula": {
                                "type": "string"
                            },
                            "purity": {
                                "type": "number"
                            },
                            "source": {
                                "type": "string"
                            },
                            "synthesis_method": {
                                "type": "string",
                                "description": "Vertex modification approach (e.g., fluorination)"
                            }
                        }
                    }
                },
                "counter_ions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "chemical_formula": {
                                "type": "string"
                            },
                            "binding_strength": {
                                "type": "number",
                                "description": "Relative binding affinity scale"
                            }
                        }
                    }
                },
                "template_anions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "chemical_formula": {
                                "type": "string"
                            },
                            "role": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "process_parameters": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "step_number": {
                        "type": "integer"
                    },
                    "action": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "temperature": {
                                "type": "number",
                                "description": "Reaction temperature in \u00b0C"
                            },
                            "time": {
                                "type": "number",
                                "description": "Reaction duration in hours"
                            },
                            "solvent": {
                                "type": "string"
                            },
                            "pressure": {
                                "type": "object",
                                "properties": {
                                    "value": {
                                        "type": "number"
                                    },
                                    "vacuum": {
                                        "type": "boolean"
                                    }
                                }
                            },
                            "reaction_medium": {
                                "type": "string"
                            },
                            "anion_concentration": {
                                "type": "number",
                                "description": "Counter-ion concentration in mol/L"
                            }
                        },
                        "required": [
                            "temperature",
                            "time",
                            "solvent",
                            "pressure",
                            "reaction_medium"
                        ]
                    }
                },
                "required": [
                    "step_number",
                    "action",
                    "parameters"
                ]
            }
        },
        "characterization": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Analytical techniques used (e.g., SCXRD, NMR, ESI-TOF MS)"
        },
        "structural_properties": {
            "type": "object",
            "properties": {
                "geometry": {
                    "type": "string"
                },
                "symmetry": {
                    "type": "string"
                },
                "metal_stereochemistry": {
                    "type": "string"
                }
            }
        },
        "host_guest_properties": {
            "type": "object",
            "properties": {
                "guest_binding_selectivity": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Preferred guest binding hierarchy"
                },
                "binding_thermodynamics": {
                    "type": "object",
                    "properties": {
                        "association_constant": {
                            "type": "number",
                            "description": "K value in L/mol"
                        },
                        "delta_g": {
                            "type": "number",
                            "description": "Gibbs free energy change (kcal/mol)"
                        },
                        "delta_h": {
                            "type": "number",
                            "description": "Enthalpy change (kcal/mol)"
                        },
                        "t_delta_s": {
                            "type": "number",
                            "description": "Entropy change (kcal/mol)"
                        }
                    }
                },
                "guest_displacement": {
                    "type": "object",
                    "properties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of displaced guest species"
                    }
                }
            }
        }
    }
}