{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Catalytic Pyrolysis of Mixed Plastic Waste Process",
    "description": "A schema representing the key parameters, conditions, and outputs of the catalytic pyrolysis process for mixed plastic waste.",
    "type": "object",
    "properties": {
        "process_metadata": {
            "type": "object",
            "description": "Metadata about the pyrolysis process, including identifiers and scale.",
            "properties": {
                "process_id": {
                    "type": "string",
                    "description": "Unique identifier for the pyrolysis process instance."
                },
                "experiment_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date when the experiment was conducted (YYYY-MM-DD)."
                },
                "operational_scale": {
                    "type": "string",
                    "description": "Scale of the process (e.g., laboratory, pilot, industrial).",
                    "enum": [
                        "laboratory",
                        "pilot",
                        "industrial"
                    ]
                },
                "notes": {
                    "type": "string",
                    "description": "Additional notes or observations about the process."
                }
            },
            "required": [
                "operational_scale"
            ]
        },
        "feedstock": {
            "type": "object",
            "description": "Details about the plastic feedstock used in the pyrolysis process.",
            "properties": {
                "plastic_types": {
                    "type": "array",
                    "description": "List of polymer types present in the feedstock (e.g., PE, PP, PS, PET).",
                    "items": {
                        "type": "string",
                        "enum": [
                            "PE",
                            "PP",
                            "PS",
                            "PET",
                            "PVC",
                            "LDPE",
                            "HDPE",
                            "mixed"
                        ]
                    }
                },
                "composition": {
                    "type": "array",
                    "description": "Relative proportion of each polymer type in the feedstock (percentage by mass).",
                    "items": {
                        "type": "object",
                        "properties": {
                            "polymer_type": {
                                "type": "string",
                                "description": "Type of polymer (e.g., PE, PP)."
                            },
                            "percentage": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100,
                                "description": "Percentage of the polymer in the feedstock (mass basis)."
                            }
                        },
                        "required": [
                            "polymer_type",
                            "percentage"
                        ]
                    }
                },
                "feedstock_preparation": {
                    "type": "object",
                    "description": "Details on how the feedstock was prepared before pyrolysis.",
                    "properties": {
                        "shredding": {
                            "type": "boolean",
                            "description": "Whether the feedstock was shredded prior to processing."
                        },
                        "particle_size_mm": {
                            "type": "number",
                            "description": "Average particle size of the feedstock in millimeters."
                        },
                        "drying": {
                            "type": "boolean",
                            "description": "Whether the feedstock was dried prior to processing."
                        },
                        "drying_temperature_c": {
                            "type": "number",
                            "description": "Temperature at which the feedstock was dried (in \u00b0C)."
                        },
                        "moisture_content_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Moisture content of the feedstock as a percentage by mass."
                        }
                    }
                },
                "contaminants": {
                    "type": "object",
                    "description": "Contaminants present in the feedstock.",
                    "properties": {
                        "chlorine_ppm": {
                            "type": "number",
                            "description": "Chlorine content from PVC-containing feedstock in parts per million (ppm)."
                        },
                        "heavy_metals": {
                            "type": "array",
                            "description": "Heavy metals present in the feedstock (e.g., Pb, Cd, Zn, Cu).",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "required": [
                "plastic_types",
                "composition"
            ]
        },
        "catalyst": {
            "type": "object",
            "description": "Details about the catalyst used in the pyrolysis process.",
            "properties": {
                "catalyst_type": {
                    "type": "string",
                    "description": "Type of catalyst used (e.g., zeolite, FCC, metal-supported).",
                    "enum": [
                        "zeolite",
                        "FCC",
                        "metal-supported",
                        "acidic",
                        "basic",
                        "other"
                    ]
                },
                "catalyst_name": {
                    "type": "string",
                    "description": "Specific name or identifier of the catalyst (e.g., ZSM-5, HY)."
                },
                "catalyst_to_feed_ratio": {
                    "type": "number",
                    "description": "Mass ratio of catalyst to plastic feedstock (e.g., 0.1 for 10% catalyst).",
                    "minimum": 0
                },
                "catalyst_properties": {
                    "type": "object",
                    "description": "Additional properties of the catalyst.",
                    "properties": {
                        "surface_area_m2_g": {
                            "type": "number",
                            "description": "Surface area of the catalyst in m\u00b2/g."
                        },
                        "pore_size_nm": {
                            "type": "number",
                            "description": "Average pore size of the catalyst in nanometers."
                        },
                        "acidity": {
                            "type": "string",
                            "description": "Acidity level of the catalyst (e.g., low, medium, high)."
                        }
                    }
                },
                "characterization_methods": {
                    "type": "array",
                    "description": "Analytical techniques used to characterize catalyst properties.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "BET",
                            "NH3-TPD",
                            "XRD",
                            "SEM",
                            "FT-IR",
                            "TGA",
                            "ICP-OES"
                        ]
                    }
                }
            },
            "required": [
                "catalyst_type"
            ]
        },
        "reactor": {
            "type": "object",
            "description": "Details about the reactor configuration.",
            "properties": {
                "reactor_type": {
                    "type": "string",
                    "description": "Type of reactor used (e.g., fixed-bed, fluidized-bed, batch, continuous).",
                    "enum": [
                        "fixed-bed",
                        "fluidized-bed",
                        "batch",
                        "continuous"
                    ]
                },
                "reactor_volume_l": {
                    "type": "number",
                    "description": "Volume of the reactor in liters."
                }
            },
            "required": [
                "reactor_type"
            ]
        },
        "process_conditions": {
            "type": "object",
            "description": "Thermal and kinetic operating parameters of the pyrolysis process.",
            "properties": {
                "temperature_c": {
                    "type": "number",
                    "minimum": 300,
                    "maximum": 700,
                    "description": "Reaction temperature in \u00b0C."
                },
                "heating_rate_c_min": {
                    "type": "number",
                    "description": "Heating rate in \u00b0C per minute."
                },
                "residence_time_min": {
                    "type": "number",
                    "description": "Residence time of the feedstock in the reactor in minutes."
                },
                "pressure_kpa": {
                    "type": "number",
                    "description": "Pressure inside the reactor in kilopascals (kPa)."
                },
                "reaction_atmosphere": {
                    "type": "string",
                    "description": "Gaseous environment in the reactor (e.g., nitrogen, argon, hydrogen).",
                    "enum": [
                        "nitrogen",
                        "argon",
                        "hydrogen",
                        "helium",
                        "other"
                    ]
                },
                "gas_flow_rate_l_min": {
                    "type": "number",
                    "description": "Flow rate of the carrier gas in liters per minute.",
                    "minimum": 0
                }
            },
            "required": [
                "temperature_c",
                "reaction_atmosphere"
            ]
        },
        "products": {
            "type": "object",
            "description": "Details about the products generated from the pyrolysis process.",
            "properties": {
                "yields": {
                    "type": "object",
                    "description": "Yields of the different product fractions (percentage of initial feedstock mass).",
                    "properties": {
                        "liquid_yield_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Yield of liquid products as a percentage of initial feedstock mass."
                        },
                        "gas_yield_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Yield of gaseous products as a percentage of initial feedstock mass."
                        },
                        "solid_residue_yield_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Yield of solid residue (char) as a percentage of initial feedstock mass."
                        }
                    },
                    "required": [
                        "liquid_yield_percent",
                        "gas_yield_percent",
                        "solid_residue_yield_percent"
                    ]
                },
                "liquid_product_composition": {
                    "type": "array",
                    "description": "Chemical composition of the liquid product fraction.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "compound_name": {
                                "type": "string",
                                "description": "Name of the chemical compound (e.g., benzene, toluene)."
                            },
                            "percentage": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100,
                                "description": "Percentage of the compound in the liquid fraction."
                            },
                            "boiling_point_c": {
                                "type": "number",
                                "description": "Boiling point of the compound in \u00b0C."
                            }
                        },
                        "required": [
                            "compound_name",
                            "percentage"
                        ]
                    }
                },
                "gas_product_composition": {
                    "type": "array",
                    "description": "Chemical composition of the gaseous product fraction.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "compound_name": {
                                "type": "string",
                                "description": "Name of the chemical compound (e.g., methane, ethylene)."
                            },
                            "percentage": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100,
                                "description": "Percentage of the compound in the gas fraction."
                            }
                        },
                        "required": [
                            "compound_name",
                            "percentage"
                        ]
                    }
                },
                "solid_residue_analysis": {
                    "type": "object",
                    "description": "Analysis of the solid residue (char) produced.",
                    "properties": {
                        "carbon_content_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Carbon content of the solid residue as a percentage."
                        },
                        "ash_content_percent": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Ash content of the solid residue as a percentage."
                        },
                        "contaminants": {
                            "type": "object",
                            "description": "Contaminants present in the solid residue.",
                            "properties": {
                                "chlorine_ppm": {
                                    "type": "number",
                                    "description": "Chlorine content in the solid residue in parts per million (ppm)."
                                },
                                "heavy_metals": {
                                    "type": "array",
                                    "description": "Heavy metals present in the solid residue (e.g., Pb, Cd, Zn, Cu).",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "required": [
                "yields"
            ]
        },
        "analytical_methods": {
            "type": "object",
            "description": "Methods used to analyze the feedstock and products.",
            "properties": {
                "feedstock_analysis": {
                    "type": "array",
                    "description": "Analytical methods used for feedstock characterization.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "TGA",
                            "FTIR",
                            "DSC",
                            "XRD",
                            "SEM",
                            "other"
                        ]
                    }
                },
                "liquid_analysis": {
                    "type": "array",
                    "description": "Analytical methods used for liquid product characterization.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "GC-MS",
                            "GC-FID",
                            "GCxGC-FID/MS",
                            "FTIR",
                            "NMR",
                            "simulated_distillation",
                            "bomb calorimetry",
                            "ASTM D2887",
                            "ASTM D4868",
                            "other"
                        ]
                    }
                },
                "gas_analysis": {
                    "type": "array",
                    "description": "Analytical methods used for gas product characterization.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "GC-TCD",
                            "GC-FID",
                            "MS",
                            "other"
                        ]
                    }
                },
                "solid_analysis": {
                    "type": "array",
                    "description": "Analytical methods used for solid residue characterization.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "TGA",
                            "FTIR",
                            "XRD",
                            "SEM",
                            "EDX",
                            "other"
                        ]
                    }
                }
            }
        },
        "performance_metrics": {
            "type": "object",
            "description": "Key performance metrics of the pyrolysis process.",
            "properties": {
                "conversion_efficiency_percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Percentage of feedstock converted into products (100% - solid residue yield)."
                },
                "energy_efficiency": {
                    "type": "number",
                    "description": "Energy efficiency of the process (e.g., ratio of energy output to input)."
                },
                "catalyst_lifetime": {
                    "type": "number",
                    "description": "Estimated lifetime of the catalyst in hours or cycles."
                }
            }
        }
    },
    "required": [
        "feedstock",
        "catalyst",
        "reactor",
        "process_conditions",
        "products",
        "process_metadata"
    ]
}