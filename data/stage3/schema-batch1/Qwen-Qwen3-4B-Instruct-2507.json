{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/catalytic-pyrolysis-mixed-plastic-waste",
    "title": "Catalytic Pyrolysis of Mixed Plastic Waste Process Schema",
    "description": "A comprehensive JSON schema representing the key parameters and outputs of the Catalytic Pyrolysis of Mixed Plastic Waste process, including feedstock, reactor conditions, operational parameters, product yields, compositions, and detailed characterization data. The schema includes metadata, feedstock preprocessing, catalyst properties, product quality metrics, mass balance closure, and analytical methods. Enhanced to support real-world mixed plastic waste with contaminant tracking, multi-step preprocessing, expanded analytical techniques, and accurate mass balance reporting.",
    "type": "object",
    "properties": {
        "metadata": {
            "type": "object",
            "properties": {
                "study_id": {
                    "type": "string",
                    "description": "Unique identifier for the study or experiment (e.g., STY-2024-001)."
                },
                "author": {
                    "type": "string",
                    "description": "Name(s) of the researcher(s) or institution(s) responsible for the study."
                },
                "doi": {
                    "type": "string",
                    "description": "Digital Object Identifier (DOI) linking to the published research (e.g., 10.1016/j.jhazmat.2024.132456)."
                },
                "publication_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date of publication in ISO 8601 format (e.g., 2024-06-15)."
                }
            },
            "additionalProperties": false
        },
        "feedstock": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The primary category of polymeric material used as input (e.g., PE, PP, PS, PET, PVC, PO, or 'mixed plastic waste').",
                    "enum": [
                        "PE",
                        "PP",
                        "PS",
                        "PET",
                        "PVC",
                        "PO",
                        "mixed plastic waste"
                    ],
                    "default": "mixed plastic waste"
                },
                "composition": {
                    "type": "object",
                    "description": "Relative proportions of polymer types in the input stream (e.g., 40% PE, 30% PP, 30% PET). Keys are polymer types; values are percentages (0\u2013100) that sum to 100.",
                    "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    },
                    "required": false,
                    "default": {}
                },
                "preprocessing": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "method": {
                                "type": "string",
                                "enum": [
                                    "shredding",
                                    "drying",
                                    "washing",
                                    "grinding",
                                    "sorting"
                                ],
                                "description": "Preprocessing technique applied (e.g., shredding, drying, washing, grinding, sorting)."
                            },
                            "temperature_c": {
                                "type": "number",
                                "description": "Drying or treatment temperature in degrees Celsius (\u00b0C), if applicable.",
                                "minimum": 0,
                                "maximum": 200
                            },
                            "duration_min": {
                                "type": "number",
                                "description": "Duration of preprocessing step in minutes (min).",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "method"
                        ]
                    },
                    "description": "List of sequential preprocessing steps applied to the feedstock before pyrolysis. Each step may include a method, temperature, and duration."
                },
                "contaminants": {
                    "type": "object",
                    "properties": {
                        "chlorine_ppm": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Chlorine content in feedstock (ppm), critical for PVC-containing waste and potential catalyst deactivation."
                        },
                        "heavy_metals": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "List of heavy metals detected in the feedstock (e.g., Pb, Cd, Zn, Cu)."
                        }
                    },
                    "description": "Trace contaminants in the feedstock that may affect catalytic performance and product quality."
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "catalyst": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The catalytic material used (e.g., zeolites, natural zeolites, FCC catalysts, clay catalysts, metal-supported systems, MOF-derived, gamma-alumina, or others).",
                    "enum": [
                        "zeolites",
                        "natural zeolites",
                        "FCC catalysts",
                        "clay catalysts",
                        "metal-supported systems",
                        "MOF-derived",
                        "gamma-alumina",
                        "other"
                    ],
                    "default": "zeolites"
                },
                "to_feed_ratio": {
                    "type": "number",
                    "description": "Mass ratio of catalyst to plastic feedstock (e.g., 1:10 means 1 g catalyst per 10 g feedstock).",
                    "minimum": 0,
                    "default": 0.1
                },
                "characterization": {
                    "type": "object",
                    "description": "Physical and chemical properties of the catalyst used in the process.",
                    "properties": {
                        "methods": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "BET",
                                    "NH3-TPD",
                                    "XRD",
                                    "SEM",
                                    "FT-IR",
                                    "TGA"
                                ]
                            },
                            "description": "List of characterization techniques used to evaluate catalyst properties."
                        },
                        "surface_area_m2_per_g": {
                            "type": "number",
                            "description": "BET surface area of the catalyst in square meters per gram (m\u00b2/g).",
                            "minimum": 0
                        },
                        "acidity": {
                            "type": "string",
                            "description": "Acidity profile derived from NH3-TPD (e.g., weak, medium, strong acid sites).",
                            "enum": [
                                "weak",
                                "medium",
                                "strong"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": false
                }
            },
            "required": [
                "type",
                "to_feed_ratio"
            ],
            "additionalProperties": false
        },
        "reactor": {
            "type": "object",
            "properties": {
                "configuration": {
                    "type": "string",
                    "description": "The design and operational setup of the reactor (e.g., fixed-bed, fluidized-bed, batch, continuous, slurry-bed).",
                    "enum": [
                        "fixed-bed",
                        "fluidized-bed",
                        "batch",
                        "continuous",
                        "slurry-bed"
                    ],
                    "default": "fixed-bed"
                },
                "pressure": {
                    "type": "number",
                    "description": "Operating pressure in kilopascals (kPa). Typically near atmospheric unless specified otherwise.",
                    "minimum": 0,
                    "default": 101.3
                },
                "atmosphere": {
                    "type": "string",
                    "description": "Gaseous environment within the reactor (e.g., nitrogen, argon, hydrogen, inert gas, air).",
                    "enum": [
                        "nitrogen",
                        "argon",
                        "hydrogen",
                        "inert gas",
                        "air"
                    ],
                    "default": "nitrogen"
                },
                "carrier_gas_flow_rate": {
                    "type": "number",
                    "description": "Flow rate of the carrier gas (e.g., nitrogen or argon) in standard cubic meters per hour (m\u00b3/h) or liters per minute (L/min).",
                    "minimum": 0,
                    "default": 100
                }
            },
            "required": [
                "configuration",
                "atmosphere"
            ],
            "additionalProperties": false
        },
        "operational_conditions": {
            "type": "object",
            "properties": {
                "temperature": {
                    "type": "number",
                    "description": "Operating temperature during thermal degradation, typically in degrees Celsius (\u00b0C).",
                    "minimum": 300,
                    "maximum": 700,
                    "default": 450
                },
                "heating_rate": {
                    "type": "number",
                    "description": "Rate at which temperature is increased during the process, in \u00b0C per minute (\u00b0C/min).",
                    "minimum": 0,
                    "default": 10
                },
                "residence_time": {
                    "type": "number",
                    "description": "Duration for which feedstock and intermediates remain under reaction conditions, in minutes (min).",
                    "minimum": 0,
                    "default": 15
                }
            },
            "required": [
                "temperature",
                "heating_rate",
                "residence_time"
            ],
            "additionalProperties": false
        },
        "scale": {
            "type": "string",
            "description": "The experimental scale at which the process is conducted (laboratory, pilot, industrial).",
            "enum": [
                "laboratory",
                "pilot",
                "industrial"
            ],
            "default": "laboratory"
        },
        "product_yields": {
            "type": "object",
            "properties": {
                "liquid_yield": {
                    "type": "number",
                    "description": "Proportion of liquid fraction generated, expressed as a percentage of initial feedstock mass.",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 40
                },
                "gaseous_yield": {
                    "type": "number",
                    "description": "Proportion of gaseous products formed, expressed as a percentage of initial feedstock mass.",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 30
                },
                "solid_residue_yield": {
                    "type": "number",
                    "description": "Proportion of solid carbonaceous residue (char) remaining after conversion, expressed as a percentage of initial feedstock mass.",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 30
                }
            },
            "required": [
                "liquid_yield",
                "gaseous_yield",
                "solid_residue_yield"
            ],
            "additionalProperties": false
        },
        "product_composition": {
            "type": "object",
            "properties": {
                "liquid": {
                    "type": "array",
                    "description": "List of main chemical compounds identified in the liquid fraction (e.g., n-hexadecane, benzene, cyclohexane). Each entry should include a compound name and optionally its concentration (in wt%).",
                    "items": {
                        "type": "object",
                        "properties": {
                            "compound": {
                                "type": "string",
                                "description": "Chemical name of the compound (e.g., benzene, n-hexadecane)."
                            },
                            "concentration_wt_percent": {
                                "type": "number",
                                "description": "Concentration of the compound in the liquid fraction, expressed as a percentage of total liquid mass (0\u2013100).",
                                "minimum": 0,
                                "maximum": 100
                            }
                        },
                        "required": [
                            "compound"
                        ]
                    },
                    "default": []
                },
                "gas": {
                    "type": "array",
                    "description": "List of main chemical compounds identified in the gaseous fraction (e.g., methane, ethylene, hydrogen). Each entry should include a compound name and optionally its concentration (in vol%).",
                    "items": {
                        "type": "object",
                        "properties": {
                            "compound": {
                                "type": "string",
                                "description": "Chemical name of the compound (e.g., methane, ethylene, hydrogen)."
                            },
                            "concentration_vol_percent": {
                                "type": "number",
                                "description": "Concentration of the compound in the gas phase, expressed as a percentage of total gas volume (0\u2013100).",
                                "minimum": 0,
                                "maximum": 100
                            }
                        },
                        "required": [
                            "compound"
                        ]
                    },
                    "default": []
                },
                "char": {
                    "type": "object",
                    "description": "Properties of the solid residue (char) produced during pyrolysis.",
                    "properties": {
                        "carbon_content_pct": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Fixed carbon content of char (wt%)."
                        },
                        "ash_content_pct": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Ash content of char (wt%)."
                        },
                        "chlorine_ppm": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Chlorine content in char (ppm)."
                        }
                    }
                }
            },
            "required": [
                "liquid",
                "gas",
                "char"
            ],
            "additionalProperties": false
        },
        "product_quality": {
            "type": "object",
            "description": "Key quality metrics of the liquid and gaseous products.",
            "properties": {
                "liquid": {
                    "type": "object",
                    "description": "Thermal and physical properties of the liquid product.",
                    "properties": {
                        "higher_heating_value": {
                            "type": "number",
                            "description": "Higher heating value (HHV) of the liquid fraction in megajoules per kilogram (MJ/kg).",
                            "minimum": 0,
                            "maximum": 50
                        },
                        "viscosity": {
                            "type": "number",
                            "description": "Viscosity of the liquid product in centipoise (cP).",
                            "minimum": 0
                        },
                        "density": {
                            "type": "number",
                            "description": "Density of the liquid product in kilograms per cubic meter (kg/m\u00b3).",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                },
                "gas": {
                    "type": "object",
                    "description": "Thermal and physical properties of the gaseous product.",
                    "properties": {
                        "lower_heating_value": {
                            "type": "number",
                            "description": "Lower heating value (LHV) of the gas fraction in megajoules per kilogram (MJ/kg).",
                            "minimum": 0,
                            "maximum": 50
                        },
                        "calorific_value": {
                            "type": "number",
                            "description": "Calorific value of the gas in MJ/m\u00b3 at standard conditions (STP).",
                            "minimum": 0
                        },
                        "co2_content_vol_percent": {
                            "type": "number",
                            "description": "Carbon dioxide concentration in the gas phase, expressed as a percentage of total gas volume (0\u2013100).",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "sulfur_content_vol_percent": {
                            "type": "number",
                            "description": "Sulfur concentration in the gas phase, expressed as a percentage of total gas volume (0\u2013100).",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "mass_balance_closure": {
            "type": "number",
            "description": "Sum of liquid + gas + char yields as a percentage. Should be ~100% within experimental error (typically 95\u2013105%).",
            "minimum": 80,
            "maximum": 120
        },
        "analytical_characterisation": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "GC-MS",
                    "GC-FID",
                    "GCxGC-FID/MS",
                    "FTIR",
                    "TGA",
                    "NMR",
                    "HPLC",
                    "MS",
                    "IR",
                    "BET",
                    "NH3-TPD",
                    "XRD",
                    "SEM",
                    "bomb calorimetry",
                    "ASTM D2887",
                    "ASTM D4868",
                    "ASTM D4294"
                ]
            },
            "description": "List of experimental techniques used to analyse feedstock and products (e.g., GC-MS, FTIR, TGA, NMR, HPLC, MS, IR, BET, NH3-TPD, XRD, SEM, bomb calorimetry, ASTM fuel tests)."
        }
    },
    "required": [
        "metadata",
        "feedstock",
        "catalyst",
        "reactor",
        "operational_conditions",
        "scale",
        "product_yields",
        "product_composition",
        "product_quality",
        "mass_balance_closure",
        "analytical_characterisation"
    ],
    "additionalProperties": false,
    "examples": [
        {
            "metadata": {
                "study_id": "STY-2024-001",
                "author": "Dr. A. Sharma et al.",
                "doi": "10.1016/j.jhazmat.2024.132456",
                "publication_date": "2024-06-15"
            },
            "feedstock": {
                "type": "mixed plastic waste",
                "composition": {
                    "PE": 50,
                    "PP": 30,
                    "PS": 20
                },
                "preprocessing": [
                    {
                        "method": "shredding",
                        "temperature_c": 80,
                        "duration_min": 30
                    },
                    {
                        "method": "drying",
                        "temperature_c": 60,
                        "duration_min": 20
                    }
                ],
                "contaminants": {
                    "chlorine_ppm": 15,
                    "heavy_metals": [
                        "Pb",
                        "Zn"
                    ]
                }
            },
            "catalyst": {
                "type": "zeolites",
                "to_feed_ratio": 0.15,
                "characterization": {
                    "methods": [
                        "BET",
                        "NH3-TPD",
                        "XRD",
                        "TGA"
                    ],
                    "surface_area_m2_per_g": 450,
                    "acidity": "strong"
                }
            },
            "reactor": {
                "configuration": "fixed-bed",
                "pressure": 101.3,
                "atmosphere": "nitrogen",
                "carrier_gas_flow_rate": 120
            },
            "operational_conditions": {
                "temperature": 450,
                "heating_rate": 15,
                "residence_time": 20
            },
            "scale": "laboratory",
            "product_yields": {
                "liquid_yield": 60,
                "gaseous_yield": 25,
                "solid_residue_yield": 15
            },
            "product_composition": {
                "liquid": [
                    {
                        "compound": "n-hexadecane",
                        "concentration_wt_percent": 30
                    },
                    {
                        "compound": "benzene",
                        "concentration_wt_percent": 15
                    }
                ],
                "gas": [
                    {
                        "compound": "methane",
                        "concentration_vol_percent": 40
                    },
                    {
                        "compound": "ethylene",
                        "concentration_vol_percent": 20
                    }
                ],
                "char": {
                    "carbon_content_pct": 78,
                    "ash_content_pct": 12,
                    "chlorine_ppm": 5
                }
            },
            "product_quality": {
                "liquid": {
                    "higher_heating_value": 42.5,
                    "viscosity": 120,
                    "density": 850
                },
                "gas": {
                    "lower_heating_value": 38.0,
                    "calorific_value": 35.2,
                    "co2_content_vol_percent": 1.5,
                    "sulfur_content_vol_percent": 0.3
                }
            },
            "mass_balance_closure": 97.5,
            "analytical_characterisation": [
                "GC-MS",
                "FTIR",
                "TGA",
                "NMR",
                "BET",
                "NH3-TPD",
                "ASTM D2887"
            ]
        }
    ]
}