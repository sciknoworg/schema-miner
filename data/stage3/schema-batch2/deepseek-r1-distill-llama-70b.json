{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Catalytic Pyrolysis of Mixed Plastic Waste Process",
    "description": "JSON schema representing the Catalytic Pyrolysis of Mixed Plastic Waste process parameters and outcomes, incorporating comprehensive properties and accurate constraints.",
    "type": "object",
    "properties": {
        "metadata": {
            "type": "object",
            "description": "Metadata related to the study or experiment.",
            "properties": {
                "study_id": {
                    "type": "string",
                    "description": "Unique identifier for the study or experiment."
                },
                "author": {
                    "type": "string",
                    "description": "Author or researcher responsible for the study."
                },
                "doi": {
                    "type": "string",
                    "description": "Digital Object Identifier for the study (e.g., 10.1016/j.jhazmat.2024.132456). Accepts plain DOI strings without URL prefix."
                }
            },
            "required": [
                "study_id",
                "author",
                "doi"
            ]
        },
        "feedstock": {
            "type": "object",
            "description": "Properties related to the plastic feedstock used in the process.",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Category of polymeric material used as input (e.g., PE, PP, PS, PET, or mixed).",
                    "enum": [
                        "PE",
                        "PP",
                        "PS",
                        "PET",
                        "mixed"
                    ]
                },
                "composition": {
                    "type": "object",
                    "description": "Relative proportion of polymer types as mass percentages (0-100). Sum should equal 100.",
                    "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    }
                },
                "preparation": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "mechanical sorting",
                            "shredding",
                            "dry-washing",
                            "drying"
                        ]
                    },
                    "description": "Feedstock pretreatment steps applied before pyrolysis."
                },
                "contaminants": {
                    "type": "object",
                    "description": "Contaminants present in the feedstock.",
                    "properties": {
                        "chlorine_ppm": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Chlorine content in the feedstock from PVC (parts per million)."
                        },
                        "heavy_metals": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Heavy metals detected (e.g., Pb, Cd, Zn)."
                        }
                    }
                },
                "particle_size_mm": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Average particle size of the feedstock in millimeters (mm)."
                },
                "moisture_content_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Moisture content of the feedstock (wt%)."
                }
            },
            "required": [
                "type",
                "composition"
            ]
        },
        "catalyst": {
            "type": "object",
            "description": "Properties related to the catalyst used in the process.",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Catalytic material applied (e.g., ZSM-5, montmorillonite, MIL-53-derived).",
                    "enum": [
                        "zeolites",
                        "natural zeolites",
                        "FCC",
                        "metal-supported",
                        "clay catalysts",
                        "MOF-derived",
                        "gamma-alumina",
                        "red mud",
                        "other"
                    ]
                },
                "catalyst_to_feed_ratio": {
                    "type": "number",
                    "description": "Mass ratio between catalyst and plastic feedstock.",
                    "minimum": 0
                },
                "BET_surface_area": {
                    "type": "number",
                    "description": "Brunauer-Emmett-Teller surface area of the catalyst in m\u00b2/g.",
                    "minimum": 0
                },
                "acidity": {
                    "type": "number",
                    "description": "Acidity of the catalyst as determined by NH3-TPD.",
                    "minimum": 0
                },
                "characterization_methods": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "BET",
                            "NH3-TPD",
                            "XRD",
                            "SEM",
                            "FT-IR",
                            "TGA",
                            "ICP-OES"
                        ]
                    },
                    "description": "Analytical techniques used to characterize the catalyst."
                }
            },
            "required": [
                "type",
                "catalyst_to_feed_ratio"
            ]
        },
        "reactor": {
            "type": "object",
            "description": "Properties related to the reactor configuration and operation.",
            "properties": {
                "configuration": {
                    "type": "string",
                    "description": "Design and operational setup of the reactor.",
                    "enum": [
                        "fixed-bed",
                        "fluidized-bed",
                        "batch",
                        "continuous"
                    ]
                },
                "scale": {
                    "type": "string",
                    "description": "Experimental scale of the process.",
                    "enum": [
                        "laboratory",
                        "pilot",
                        "industrial"
                    ]
                },
                "pressure": {
                    "type": "number",
                    "description": "Operating pressure within the reactor in MPa.",
                    "minimum": 0
                }
            },
            "required": [
                "configuration",
                "scale"
            ]
        },
        "operational_parameters": {
            "type": "object",
            "description": "Key operational parameters of the pyrolysis process.",
            "properties": {
                "temperature": {
                    "type": "number",
                    "description": "Operating temperature in degrees Celsius.",
                    "minimum": 300,
                    "maximum": 700
                },
                "heating_rate": {
                    "type": "number",
                    "description": "Rate of temperature increase during the process in \u00b0C/min.",
                    "minimum": 0
                },
                "residence_time": {
                    "type": "number",
                    "description": "Duration feedstock remains under reaction conditions in minutes.",
                    "minimum": 0
                },
                "atmosphere": {
                    "type": "string",
                    "description": "Gaseous environment within the reactor.",
                    "enum": [
                        "nitrogen",
                        "argon",
                        "hydrogen"
                    ]
                },
                "carrier_gas_flow_rate": {
                    "type": "number",
                    "description": "Flow rate of carrier gas in mL/min.",
                    "minimum": 0
                }
            },
            "required": [
                "temperature",
                "heating_rate",
                "residence_time",
                "atmosphere"
            ]
        },
        "products": {
            "type": "object",
            "description": "Properties related to the products of the pyrolysis process.",
            "properties": {
                "liquid_yield": {
                    "type": "number",
                    "description": "Proportion of liquid fraction generated, as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "gas_yield": {
                    "type": "number",
                    "description": "Proportion of gaseous products formed, as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "solid_residue": {
                    "type": "number",
                    "description": "Proportion of solid carbonaceous residue remaining, as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "composition": {
                    "type": "object",
                    "description": "Main chemical compounds in liquid, gas, and char fractions.",
                    "properties": {
                        "liquid": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "compound": {
                                        "type": "string"
                                    },
                                    "concentration_wt_pct": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                    }
                                },
                                "required": [
                                    "compound"
                                ]
                            }
                        },
                        "gas": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "compound": {
                                        "type": "string"
                                    },
                                    "concentration_vol_pct": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 100
                                    }
                                },
                                "required": [
                                    "compound"
                                ]
                            }
                        },
                        "char": {
                            "type": "object",
                            "description": "Properties of the solid residue (char).",
                            "properties": {
                                "carbon_content_pct": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 100,
                                    "description": "Fixed carbon content of char (wt%)"
                                },
                                "ash_content_pct": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 100,
                                    "description": "Ash content of char (wt%)"
                                },
                                "chlorine_ppm": {
                                    "type": "number",
                                    "minimum": 0,
                                    "description": "Chlorine content in char (ppm)"
                                }
                            }
                        }
                    }
                },
                "product_quality": {
                    "type": "object",
                    "description": "Quality characteristics of the pyrolysis products.",
                    "properties": {
                        "HHV": {
                            "type": "number",
                            "description": "Higher Heating Value of the liquid product in MJ/kg.",
                            "minimum": 0
                        },
                        "viscosity": {
                            "type": "number",
                            "description": "Viscosity of the liquid product in cP.",
                            "minimum": 0
                        },
                        "density": {
                            "type": "number",
                            "description": "Density of the liquid product in g/mL.",
                            "minimum": 0
                        },
                        "chlorine_content": {
                            "type": "number",
                            "description": "Chlorine content in the liquid product in wt.%",
                            "minimum": 0,
                            "maximum": 100
                        }
                    }
                }
            },
            "required": [
                "liquid_yield",
                "gas_yield",
                "solid_residue"
            ]
        },
        "analysis": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "GC-MS",
                    "FTIR",
                    "TGA",
                    "GC-FID",
                    "GCxGC-FID/MS",
                    "BET",
                    "NH3-TPD",
                    "XRD",
                    "SEM",
                    "bomb calorimetry",
                    "ASTM D2887",
                    "ASTM D4868",
                    "ASTM D4294"
                ]
            },
            "description": "Methods used for feedstock and product analysis."
        },
        "mass_balance_closure": {
            "type": "number",
            "description": "Sum of liquid + gas + char yields as percentage. Should equal ~100% within experimental error.",
            "minimum": 90,
            "maximum": 105
        }
    },
    "required": [
        "metadata",
        "feedstock",
        "catalyst",
        "reactor",
        "operational_parameters",
        "products",
        "analysis",
        "mass_balance_closure"
    ]
}