{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Catalytic Pyrolysis of Mixed Plastic Waste Process",
    "description": "JSON schema for representing a Catalytic Pyrolysis of Mixed Plastic Waste process and its parameters.",
    "type": "object",
    "properties": {
        "metadata": {
            "type": "object",
            "description": "Metadata about the study.",
            "properties": {
                "study_id": {
                    "type": "string",
                    "description": "Unique identifier for the study"
                },
                "author": {
                    "type": "string",
                    "description": "Name(s) of the researcher(s)"
                },
                "doi": {
                    "type": "string",
                    "description": "Digital Object Identifier for the publication"
                },
                "publication_year": {
                    "type": "integer",
                    "description": "Year of publication",
                    "minimum": 1990,
                    "maximum": 2030
                }
            },
            "required": [
                "study_id",
                "doi"
            ]
        },
        "process_id": {
            "type": "string",
            "description": "Unique identifier for the pyrolysis process instance."
        },
        "feedstock": {
            "type": "object",
            "description": "Details about the plastic feedstock used in the process.",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Category of polymeric material used as input.",
                    "enum": [
                        "PE",
                        "PP",
                        "PS",
                        "PET",
                        "LDPE",
                        "HDPE",
                        "EPS",
                        "HIPS",
                        "PVC",
                        "MLP",
                        "Mixed",
                        "Other"
                    ]
                },
                "composition": {
                    "type": "object",
                    "description": "Relative proportion of polymer types in the feedstock. Keys are polymer types, values are percentages.",
                    "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                    }
                },
                "preparation": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "mechanical sorting",
                            "shredding",
                            "dry-washing",
                            "drying",
                            "size reduction"
                        ]
                    },
                    "description": "Feedstock pretreatment steps applied before pyrolysis"
                },
                "contaminants": {
                    "type": "object",
                    "description": "Contaminant levels in the feedstock.",
                    "properties": {
                        "chlorine_ppm": {
                            "type": "number",
                            "description": "Chlorine content in feedstock (ppm)",
                            "minimum": 0
                        },
                        "heavy_metals": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Heavy metals detected (e.g., Pb, Cd, Zn, Cu)"
                        }
                    }
                }
            },
            "required": [
                "type"
            ]
        },
        "catalyst": {
            "type": "object",
            "description": "Details about the catalyst used in the process.",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Type of catalytic material (e.g., zeolites, FCC catalysts, metal-supported systems)."
                },
                "ratio": {
                    "type": "number",
                    "description": "Mass ratio of catalyst to plastic feedstock (catalyst:feed).",
                    "minimum": 0
                },
                "characterization": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "BET",
                            "NH3-TPD",
                            "XRD",
                            "SEM",
                            "FT-IR",
                            "TGA"
                        ]
                    },
                    "description": "Methods used to characterize the catalyst properties (surface area, acidity, crystallinity, morphology)"
                }
            },
            "required": [
                "type",
                "ratio"
            ]
        },
        "experimental_setup": {
            "type": "object",
            "description": "Details about the reactor configuration and operational conditions.",
            "properties": {
                "reactor_configuration": {
                    "type": "string",
                    "description": "Design and operational setup of the reactor.",
                    "enum": [
                        "fixed-bed",
                        "fluidized-bed",
                        "batch",
                        "continuous",
                        "Other"
                    ]
                },
                "temperature": {
                    "type": "number",
                    "description": "Reaction temperature in Celsius (\u00b0C). Typical range for catalytic pyrolysis: 300-700\u00b0C.",
                    "minimum": 300,
                    "maximum": 700
                },
                "heating_rate": {
                    "type": "number",
                    "description": "Heating rate in \u00b0C/min.",
                    "minimum": 0
                },
                "residence_time": {
                    "type": "number",
                    "description": "Residence time in minutes.",
                    "minimum": 0
                },
                "atmosphere": {
                    "type": "string",
                    "description": "Gaseous environment within the reactor (e.g., nitrogen, argon, hydrogen)."
                },
                "carrier_gas_flow_rate": {
                    "type": "number",
                    "description": "Flow rate of carrier gas (e.g., nitrogen) in mL/min.",
                    "minimum": 0
                },
                "pressure": {
                    "type": "number",
                    "description": "Reactor pressure in kPa.",
                    "minimum": 0
                }
            },
            "required": [
                "reactor_configuration",
                "temperature",
                "heating_rate",
                "residence_time",
                "atmosphere"
            ]
        },
        "scale": {
            "type": "string",
            "description": "Experimental scale (laboratory, pilot, or industrial).",
            "enum": [
                "laboratory",
                "pilot",
                "industrial"
            ]
        },
        "outputs": {
            "type": "object",
            "description": "Yields and composition of the pyrolysis products.",
            "properties": {
                "liquid_yield": {
                    "type": "number",
                    "description": "Liquid product yield as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "gas_yield": {
                    "type": "number",
                    "description": "Gaseous product yield as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "char_yield": {
                    "type": "number",
                    "description": "Solid residue (char) yield as a percentage of initial mass.",
                    "minimum": 0,
                    "maximum": 100
                },
                "product_composition": {
                    "type": "object",
                    "description": "Main chemical compounds identified in liquid and gas fractions.",
                    "properties": {
                        "liquid": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "compound": {
                                        "type": "string"
                                    },
                                    "concentration_wt_pct": {
                                        "type": "number",
                                        "description": "Weight percentage of the compound in the liquid product",
                                        "minimum": 0,
                                        "maximum": 100
                                    }
                                },
                                "required": [
                                    "compound"
                                ]
                            }
                        },
                        "gas": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "compound": {
                                        "type": "string"
                                    },
                                    "concentration_vol_pct": {
                                        "type": "number",
                                        "description": "Volume percentage of the compound in the gas product",
                                        "minimum": 0,
                                        "maximum": 100
                                    }
                                },
                                "required": [
                                    "compound"
                                ]
                            }
                        }
                    }
                },
                "product_quality": {
                    "type": "object",
                    "properties": {
                        "hhv": {
                            "type": "number",
                            "description": "Higher heating value in MJ/kg",
                            "minimum": 0
                        },
                        "viscosity": {
                            "type": "number",
                            "description": "Viscosity of liquid oil"
                        },
                        "density": {
                            "type": "number",
                            "description": "Density of liquid oil in g/mL"
                        },
                        "chlorine_content": {
                            "type": "number",
                            "description": "Chlorine content in ppm"
                        }
                    }
                },
                "mass_balance_closure": {
                    "type": "number",
                    "description": "Percentage closure of mass balance. Typically 95-105% within experimental error.",
                    "minimum": 80,
                    "maximum": 110
                },
                "char_composition": {
                    "type": "object",
                    "description": "Elemental composition of the solid residue (char).",
                    "properties": {
                        "carbon_content_pct": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Fixed carbon content (wt%)"
                        },
                        "ash_content_pct": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "description": "Ash content (wt%)"
                        },
                        "chlorine_ppm": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Chlorine content in char (ppm)"
                        }
                    }
                }
            },
            "required": [
                "liquid_yield",
                "gas_yield",
                "char_yield"
            ]
        },
        "analysis": {
            "type": "array",
            "description": "List of analytical characterisation methods used.",
            "items": {
                "type": "string",
                "enum": [
                    "GC-MS",
                    "GC-FID",
                    "GCxGC-FID",
                    "GCxGC-MS",
                    "FTIR",
                    "TGA",
                    "BET",
                    "NH3-TPD",
                    "XRD",
                    "SEM",
                    "Bomb Calorimetry",
                    "ASTM D2887",
                    "ASTM D4868",
                    "ASTM D4294",
                    "Other"
                ]
            }
        }
    },
    "required": [
        "feedstock",
        "catalyst",
        "experimental_setup",
        "scale",
        "outputs",
        "analysis",
        "metadata"
    ]
}